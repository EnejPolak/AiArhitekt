#
# AI Architect - Environment Variables
#
# Copy to `.env.local` (never commit secrets).
# Local vs preview vs production must use separate Supabase projects/keys.
# See docs/BACKEND.md.
#

# OpenAI (server-side only)
OPENAI_API_KEY="replace_me"

# P1.7b product-conditioned room render (server-side only). Never NEXT_PUBLIC_.
# If false/unset, Generate design returns render_disabled and does not call OpenAI Images.
# Setting true does NOT auto-generate; only an explicit Generate design click may call Images.
# Manual live smoke test: docs/P1_7C_LIVE_SMOKE_TEST.md
# OPENAI_IMAGE_RENDER_ENABLED=false
# Optional quality/size for gpt-image-1.5. Browser cannot choose these.
# input_fidelity is always high and is not env-overridable.
# OPENAI_IMAGE_QUALITY=medium
# OPENAI_IMAGE_SIZE=auto

# Google Maps (server-side only). Used by Geocoding (A) and Places (D).
GOOGLE_MAPS_API_KEY="replace_me"

# Geocoding cost protection (A only — does not affect Places)
# Set false in local/dev if you do not need live geocoding.
GOOGLE_GEOCODING_ENABLED=true
GOOGLE_GEOCODING_DAILY_LIMIT=200
GOOGLE_GEOCODING_MONTHLY_SOFT_LIMIT=8000

# ---------------------------------------------------------------------------
# Supabase — new API key model (publishable + secret)
# Dashboard: Settings → API Keys → Publishable and secret API keys
# https://supabase.com/docs/guides/getting-started/api-keys
#
# Do NOT add NEXT_PUBLIC_SUPABASE_ANON_KEY (legacy equivalent of publishable).
# Do NOT add SUPABASE_SERVICE_ROLE_KEY as the app standard (legacy secret).
# NEVER prefix elevated keys with NEXT_PUBLIC_.
#
# Local CLI (`npm run db:status`) may still print "anon key" / "service_role key".
# Map those values into the names below until the CLI emits publishable/secret.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54421"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="replace_me"

# Optional. Public app origin for email confirmation redirect URLs.
# Must match a URL in the Supabase Auth redirect allowlist (include /auth/callback).
# Local CLI defaults to http://127.0.0.1:3000. Hosted projects need the real origin.
# Production MUST set a public https origin. Do not use localhost in production.
# NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3000"

# Hosted production Supabase (never the dead ref pvzecooaaeotvwbajmty).
# Local development continues to use http://127.0.0.1:54421.
# NEXT_PUBLIC_SUPABASE_URL="https://<NEW_PROJECT_REF>.supabase.co"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="replace_me"
# SUPABASE_SECRET_KEY="replace_me"

# Optional error tracking. Leave unset to disable. Never send secrets in events.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Playwright auth-only session (never commit real values; not used by the app).
# Verified test user that can sign in at /sign-in. Do not print these.
# PLAYWRIGHT_TEST_EMAIL=
# PLAYWRIGHT_TEST_PASSWORD=

# Server only. Bypasses RLS. Required for P1.7a trusted product persist RPCs,
# P1.7b room-render trusted writes, and private project-assets writes.
# Never use for login, project CRUD, or the browser. Required in production/preview.
# SUPABASE_SECRET_KEY="replace_me"

# Legacy kitchen/home-renovation and SerpAPI debug only. Not used by the room-renovation wizard.
# Leave unset in production.
# SERPAPI_KEY=
# REPLICATE_API_TOKEN=

# Step C experimental: Luna primary + Terra targeted recovery. Server-side only.
# Default false. Forced off in production. Never NEXT_PUBLIC_.
# PRODUCT_DISCOVERY_LUNA_PRIMARY=false
# PRODUCT_DISCOVERY_SERP_FALLBACK=false
# PRODUCT_DISCOVERY_PRIMARY_PROMPT_VARIANT=

# ---------------------------------------------------------------------------
# Debug routes (`/api-debug`, POST /api/serp/reset-usage)
# Production (VERCEL_ENV / VERCEL_TARGET_ENV / APP_DEPLOYMENT_ENV=production)
# ALWAYS disables these, even if API_DEBUG_ENABLED=true.
# Do not use NODE_ENV for this gate.
# Preview / local: set true explicitly to enable.
# ---------------------------------------------------------------------------
API_DEBUG_ENABLED=false

# Optional. Use on non-Vercel hosts. Vercel sets VERCEL_ENV automatically.
# APP_DEPLOYMENT_ENV=production

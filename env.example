#
# AI Architect - Environment Variables
#
# Copy to `.env.local` (never commit secrets).
# Local vs preview vs production must use separate Supabase projects/keys.
# See docs/BACKEND.md.
#

# OpenAI (server-side only)
OPENAI_API_KEY="replace_me"

# Google Maps (server-side only). Used by Geocoding (A) and Places (D).
GOOGLE_MAPS_API_KEY="replace_me"

# Geocoding cost protection (A only — does not affect Places)
# Set false in local/dev if you do not need live geocoding.
GOOGLE_GEOCODING_ENABLED=true
GOOGLE_GEOCODING_DAILY_LIMIT=200
GOOGLE_GEOCODING_MONTHLY_SOFT_LIMIT=8000

# ---------------------------------------------------------------------------
# Supabase — new API key model (publishable + secret)
# Dashboard: Settings → API Keys → Publishable and secret API keys
# https://supabase.com/docs/guides/getting-started/api-keys
#
# Do NOT add NEXT_PUBLIC_SUPABASE_ANON_KEY (legacy equivalent of publishable).
# Do NOT add SUPABASE_SERVICE_ROLE_KEY as the app standard (legacy secret).
# NEVER prefix elevated keys with NEXT_PUBLIC_.
#
# Local CLI (`npm run db:status`) may still print "anon key" / "service_role key".
# Map those values into the names below until the CLI emits publishable/secret.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54421"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="replace_me"

# Optional. Public app origin for email confirmation redirect URLs.
# NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3000"

# Server only. Bypasses RLS. Required later for elevated access (admin/jobs/storage
# hard-delete). P1.2 user-scoped auth uses the publishable key + user JWT.
# SUPABASE_SECRET_KEY="replace_me"

# ---------------------------------------------------------------------------
# Debug routes (`/api-debug`, POST /api/serp/reset-usage)
# Production (VERCEL_ENV / VERCEL_TARGET_ENV / APP_DEPLOYMENT_ENV=production)
# ALWAYS disables these, even if API_DEBUG_ENABLED=true.
# Do not use NODE_ENV for this gate.
# Preview / local: set true explicitly to enable.
# ---------------------------------------------------------------------------
API_DEBUG_ENABLED=false

# Optional. Use on non-Vercel hosts. Vercel sets VERCEL_ENV automatically.
# APP_DEPLOYMENT_ENV=production
